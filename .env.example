# Database — law.pro.vn on Apolo Authority project (vvzpvkjlkmjjnhapsrxq, Seoul)
# Postgres schema: lpv   ← must match src/payload.config.ts postgresAdapter({ schemaName: 'lpv' })
# (The Apolo ecosystem uses Postgres SCHEMAS for site isolation, not table prefixes.)
# See: ../../../shared-assets/SUPABASE_CONFIG.md for ref details
# See: ../../../PM_CREDENTIALS.md for the real password (do not commit)
#
# Session Pooler URI — port 5432 on *.pooler.supabase.com supports prepared statements,
# so the SAME URI is used for both the Next.js runtime AND `npx payload migrate`.
# Do NOT swap to a different URI for migrations.
DATABASE_URI=postgresql://postgres.vvzpvkjlkmjjnhapsrxq:[PASSWORD]@aws-1-ap-northeast-2.pooler.supabase.com:5432/postgres

# PayloadCMS secret — generate a random 32+ character string (unique per site)
PAYLOAD_SECRET=your-secret-here

# Site
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_DEFAULT_LOCALE=vi

# Supabase client keys (for client-side SDK if needed)
NEXT_PUBLIC_SUPABASE_URL=https://vvzpvkjlkmjjnhapsrxq.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-from-supabase-dashboard
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# First-run admin seed — from PM_CREDENTIALS.md. Rotate after first login.
SEED_ADMIN_EMAIL=your-email@example.com
SEED_ADMIN_PASSWORD=replace-with-value-from-pm-credentials

# Cloudflare R2 cloud storage (REQUIRED for Netlify deploy — Netlify is stateless).
# When all four are set, Payload uploads media to R2 instead of local disk.
# Endpoint format: https://<account-id>.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_ENDPOINT=
# R2_REGION defaults to 'auto' — set only if your bucket needs a specific region
